{
  "schema_version": 1,
  "id": "builtin:gravekeep",
  "name": "Gravekeep",
  "based_on": null,
  "parts": {
    "art": { "theme": "builtin:gravekeep" },
    "scheme": { "theme": "builtin:gravekeep" },
    "palette": { "theme": "builtin:gravekeep" },
    "font": {
      "preferred": ["IBM Plex Mono", "GeistMono Nerd Font"],
      "fallback": ["FiraCode Nerd Font Mono", "JetBrains Mono", "Menlo"],
      "size": 14.0
    },
    "chrome": {
      "opacity": 0.96,
      "blur": 12,
      "padding": { "left": 8, "right": 8, "top": 6, "bottom": 6 }
    },
    "status": {
      "style": "pill",
      "segments": ["cwd", "battery", "clock", "workspace"]
    },
    "motion": {
      "scrollback_parallax": true,
      "alt_wheel_scroll": { "vertical": true, "horizontal": true },
      "auto_scroll": { "enabled": true, "speed": 3, "axis": "horizontal" }
    }
  }
}
