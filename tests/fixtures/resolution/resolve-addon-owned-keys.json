{
  "_": "Add-on mode: the user's config already set font, window_background_opacity, colors and tab_bar_at_bottom. The engine never assigns those. Font is dropped whole, colors drops both scheme and palette, and chrome drops only the matching fields. Each dropped path is reported once in 'overruled', sorted by path. Status and motion are never overruled. Fields left alone (blur, padding, tab_bar.hidden) still apply.",
  "name": "resolve-addon-owned-keys",
  "kind": "resolution",
  "covers": ["add-on-owned-keys"],
  "input": {
    "engine": {"supported_schema_version": 1, "default_preset": "builtin:neon-night"},
    "layers": {
      "builtin": {
        "presets": [
          {
            "schema_version": 1,
            "id": "builtin:rich",
            "name": "Rich",
            "based_on": null,
            "parts": {
              "art": {"theme": "builtin:neon"},
              "scheme": {"theme": "builtin:neon"},
              "palette": {"theme": "builtin:neon"},
              "font": {"preferred": ["Terminess Nerd Font"], "fallback": ["JetBrains Mono", "Menlo"]},
              "chrome": {
                "opacity": 0.9,
                "blur": 20,
                "padding": {"left": 4, "right": 4, "top": 2, "bottom": 2},
                "tab_bar": {"position": "bottom", "hidden": false}
              },
              "status": {"style": "sparkline", "segments": ["load", "clock"]},
              "motion": {}
            }
          },
          {
            "schema_version": 1,
            "id": "builtin:neon-night",
            "name": "Neon Night",
            "based_on": null,
            "parts": {
              "art": {"theme": "builtin:neon"},
              "scheme": {"theme": "builtin:neon"},
              "palette": {"theme": "builtin:neon"},
              "font": {"preferred": ["Terminess Nerd Font"], "fallback": ["JetBrains Mono", "Menlo"]},
              "chrome": {"opacity": 1},
              "status": {"style": "sparkline", "segments": ["load", "memory", "clock"]},
              "motion": {"scrollback_parallax": false}
            }
          }
        ],
        "themes": [
          {
            "schema_version": 1,
            "id": "builtin:neon",
            "name": "Neon",
            "variant": "dark",
            "palette": {
              "ui": {
                "bg": "#0a0a12",
                "surface": "#14141f",
                "fg": "#e0e0e0",
                "fg_dim": "#7a7a8c",
                "accent": "#00ff9c",
                "ok": "#00cc66",
                "warn": "#ffaa00",
                "bad": "#ff4455",
                "info": "#33aaff",
                "tab_bar_bg": "#0a0a12",
                "tab_active_bg": "#14141f",
                "tab_active_fg": "#00ff9c",
                "tab_inactive_bg": "#0a0a12",
                "tab_inactive_fg": "#7a7a8c"
              },
              "scheme": {
                "foreground": "#e0e0e0",
                "background": "#0a0a12",
                "cursor_bg": "#00ff9c",
                "cursor_fg": "#0a0a12",
                "selection_bg": "#2a2a40",
                "selection_fg": "#e0e0e0",
                "ansi": [
                  "#0a0a12",
                  "#ff4455",
                  "#00cc66",
                  "#ffaa00",
                  "#3366ff",
                  "#cc44ff",
                  "#33aaff",
                  "#e0e0e0"
                ],
                "brights": [
                  "#444466",
                  "#ff7788",
                  "#44ee99",
                  "#ffcc55",
                  "#6699ff",
                  "#dd77ff",
                  "#77ccff",
                  "#ffffff"
                ]
              }
            },
            "art": {
              "seed": 7,
              "base_color": "#0a0a12",
              "layers": [
                {
                  "id": "stars",
                  "primitive": "starfield",
                  "scale": 2,
                  "opacity": 0.5,
                  "parallax": {"vertical": 0.2, "horizontal": 0},
                  "params": {"count": 80}
                },
                {
                  "id": "grid",
                  "primitive": "perspective_grid",
                  "scale": 3,
                  "opacity": 0.8,
                  "parallax": {"vertical": 0.5}
                }
              ]
            },
            "fallback_layers": [{"kind": "color", "color": "#0a0a12"}],
            "legibility": {"text": "#e0e0e0", "dim_text": "#7a7a8c"},
            "motion": {
              "scrollback_parallax": true,
              "alt_wheel_scroll": {"vertical": true, "horizontal": false},
              "auto_scroll": {"enabled": false, "speed": 0}
            }
          }
        ],
        "overrides": null,
        "machine": null
      },
      "fleet": null,
      "local": null
    },
    "state": {"schema_version": 1, "active_preset": "builtin:rich", "history": []},
    "environment": {"installed_fonts": null},
    "addon": {"owned_keys": ["font", "window_background_opacity", "colors", "tab_bar_at_bottom"]}
  },
  "expected": {
    "overruled": [
      {"path": "chrome.opacity", "config_key": "window_background_opacity"},
      {"path": "chrome.tab_bar.position", "config_key": "tab_bar_at_bottom"},
      {"path": "font", "config_key": "font"},
      {"path": "palette", "config_key": "colors"},
      {"path": "scheme", "config_key": "colors"}
    ],
    "ignored": [],
    "notices": [],
    "error": null
  },
  "expect_at": {
    "/resolved/parts/chrome": {
      "blur": 20,
      "padding": {"left": 4, "right": 4, "top": 2, "bottom": 2},
      "tab_bar": {"hidden": false}
    },
    "/resolved/parts/status/style": "sparkline"
  },
  "expect_absent": [
    "/resolved/parts/font",
    "/resolved/parts/scheme",
    "/resolved/parts/palette",
    "/resolved/parts/chrome/opacity",
    "/resolved/parts/chrome/tab_bar/position"
  ]
}
